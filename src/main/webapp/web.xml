<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
    version="6.0">

    <display-name>TapTable</display-name>

    <!-- Context configuration -->
    <context-param>
        <param-name>db.url</param-name>
        <param-value>jdbc:postgresql://localhost:5432/app</param-value>
    </context-param>
    <context-param>
        <param-name>db.user</param-name>
        <param-value>admin</param-value>
    </context-param>
    <context-param>
        <param-name>db.password</param-name>
        <param-value>admin</param-value>
    </context-param>
    <context-param>
        <param-name>jwt.secret</param-name>
        <param-value>change-me-in-production</param-value> <!-- TODO: to be changed -->
    </context-param>


    <!-- Servlets -->
    <!-- <servlet>
        <servlet-name>TestServlet</servlet-name>
        <servlet-class>com.swad.taptable.servlet.TestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestServlet</servlet-name>
        <url-pattern>/test</url-pattern>
    </servlet-mapping> -->

    <!-- Auth filter — protects all routes except login, register, error -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.swad.taptable.filter.AuthFilter</filter-class>
    </filter>

    <!-- Global error page for uncaught exceptions -->
    <!-- <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page> -->

</web-app>